    "normalProbability": true,
    "pushNotice": true,
    "areaName": {
     "sv": "Skånes sydkust",
     "en": "South coast of Skåne"
    },
    "warningLevel": {
     "sv": "Gul",
     "en": "Yellow",
     "code": "YELLOW"
    },
    "eventDescription": {
     "sv": "Högt vattenstånd",
     "en": "High sea level",
     "code": "HIGH_SEALEVEL"
    },
    "affectedAreas": [
     {
      "id": 12,
      "sv": "Skåne län",
      "en": "Skåne County"
     }
    ],
    "descriptions": [
     {
      "title": {
       "sv": "Vad händer?",
       "en": "What happens?",
       "code": "HAPPENS"
      },
      "text": {
       "sv": "Under lördagen stiger vattenståndet för att sent lördag kväll och natt mot söndag kulminera omkring 90-110 cm i RH 2000. Högst nivåer väntas i den västra delen av varningsområdet. Åter sjunkande från tidigt söndag morgon.\n",
       "en": "During Saturday the sea level will rise to culminate late Saturday evening and night into Sunday at around 90-110 cm in RH 2000. Highest levels are expected in the western part of the warning area. Dropping again from early Sunday morning.\n"
      }
     },
     {
      "title": {
       "sv": "Händelsebeskrivning",
       "en": "Description of incident",
       "code": "INCIDENT"
      },
      "text": {
       "sv": "Högt vattenstånd och blåsigt väder längs kusten ger lokalt risk för översvämning och erosion.",
       "en": "High sea levels and windy weather along the coast pose a local risk of flooding and erosion."
      }
     },
     {
      "title": {
       "sv": "Vad ska jag tänka på?",
       "en": "What should I think about?",
       "code": "AFFECT"
      },
      "text": {
       "sv": "Lågt liggande bryggor och kajer, vägar eller byggnader kan översvämmas.\nDen segelfria höjden under broar minskar.\nKänsliga kuststräckor kan utsättas för erosion.\nFörtöjda fartyg riskerar att ta skada.",
       "en": "Low lying wharfs, jetties, roads or buildings may be exposed to flooding.\nVertical clearance under bridges decreases.\nVulnerable coastal areas may suffer damage from erosion.\nMoored vessels are at risk of hull damage."
      }
     },
     {
      "title": {
       "sv": "Var?",
       "en": "Where?",
       "code": "WHERE"
      },
      "text": {
       "sv": "Från Öresundsbron till Simrishamn",
       "en": "From the Öresund Bridge to Simrishamn"
      }
     }
    ],
